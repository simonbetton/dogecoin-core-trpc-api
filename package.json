    "@trpc/client": "^11.5.0",
    "@trpc/server": "^11.5.0",
    "hono": "^4.8.10",
    "ky": "^1.8.2",
    "node-fetch": "^3.3.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@dotenvx/dotenvx": "^1.48.4",
