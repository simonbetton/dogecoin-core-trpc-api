{
  "name": "dogecoin-core-trpc-api",
  "version": "0.0.4",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonbetton/dogecoin-core-trpc-api.git"
  },
  "bugs": {
    "url": "https://github.com/simonbetton/dogecoin-core-trpc-api/issues"
  },
  "scripts": {
    "prebuild": "npm run format && npm run lint",
    "dev": "dotenvx run -- tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "build": "tsdown",
    "start": "node dist/index.cjs",
    "example": "tsx examples/client-usage.ts",
    "release": "standard-version",
    "postrelease": "git push --follow-tags origin master"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "ky": "^2.0.2",
    "superjson": "^2.2.6",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@dotenvx/dotenvx": "^1.67.0",
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "standard-version": "^9.5.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
