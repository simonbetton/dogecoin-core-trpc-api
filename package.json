{
  "name": "dogecoin-core-trpc-api",
  "version": "0.0.5",
  "packageManager": "pnpm@12.24.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonbetton/dogecoin-core-trpc-api.git"
  },
  "bugs": {
    "url": "https://github.com/simonbetton/dogecoin-core-trpc-api/issues"
  },
  "scripts": {
    "prebuild": "npm run format && npm run lint",
    "dev": "dotenvx run -- tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "build": "tsdown",
    "start": "node dist/index.cjs",
    "example": "tsx examples/client-usage.ts",
    "release": "standard-version",
    "postrelease": "git push --follow-tags origin master"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/client": "^11.31.3",
    "@trpc/server": "^11.31.3",
    "ky": "^2.2.0",
    "superjson": "^2.2.7",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/node": "^26.6.10",
    "standard-version": "^9.5.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
