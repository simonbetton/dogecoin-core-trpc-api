{
  "name": "dogecoin-core-trpc-api",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "biome format --write && biome lint .",
    "dev": "dotenvx run -- tsx watch src/index.ts",
    "build": "tsup src/index.ts src/client.ts --dts",
    "start": "node dist/index.cjs",
    "example": "tsx examples/client-usage.ts"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "ky": "^1.14.0",
    "superjson": "^2.2.6",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@dotenvx/dotenvx": "^1.51.1",
    "@types/node": "^20.11.17",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
