{
  "name": "dogecoin-core-trpc-api",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "biome format --write && biome lint .",
